# CommerceOps — local development example.
# Copy to .env and replace placeholders. Never commit a real .env.
# These values are safe placeholders for local synthetic data only.

APP_ENV=local
SPRING_PROFILES_ACTIVE=local

# PostgreSQL (shared local Compose project; one database per factory job)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecom_local
POSTGRES_USER=commerce
POSTGRES_PASSWORD=change-me-local-only

# HTTP ports
# Vite runs on VITE_PORT; Spring Boot runs on VITE_PORT + 100 and Vite proxies /api.
VITE_PORT=5173
SERVER_PORT=5273
VITE_API_PROXY_TARGET=http://localhost:5273

# Commerce defaults
CURRENCY=EUR
VAT_RATE=0.20
PAYMENT_PROVIDER=mock

# Optional failure injection (development/test only; disabled by default)
FAILURE_INJECTION_ENABLED=false
